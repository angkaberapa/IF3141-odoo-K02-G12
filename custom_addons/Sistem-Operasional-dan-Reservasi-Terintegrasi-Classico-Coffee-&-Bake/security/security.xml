<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_classico" model="ir.module.category">
            <field name="name">Classico Coffee &amp; Bake</field>
            <field name="description">Hak akses operasional Classico Coffee &amp; Bake</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_classico_staff" model="res.groups">
            <field name="name">Staff Operasional</field>
            <field name="category_id" ref="module_category_classico"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_classico_manager" model="res.groups">
            <field name="name">Manager Operasional</field>
            <field name="category_id" ref="module_category_classico"/>
            <field name="implied_ids" eval="[(4, ref('group_classico_staff'))]"/>
        </record>

        <record id="group_classico_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_classico"/>
            <field name="implied_ids" eval="[(4, ref('group_classico_manager')), (4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
