<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FR-05: Pusat Dokumentasi & Laporan -->
    
    <!-- Pivot View - Analisis Reservasi -->
    <record id="view_classico_reservation_pivot" model="ir.ui.view">
        <field name="name">classico.reservation.pivot</field>
        <field name="model">classico.reservation</field>
        <field name="arch" type="xml">
            <pivot string="Analisis Reservasi">
                <field name="reservation_date" type="row" interval="week"/>
                <field name="state" type="col"/>
                <field name="guest_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View - Trend Reservasi -->
    <record id="view_classico_reservation_graph" model="ir.ui.view">
        <field name="name">classico.reservation.graph</field>
        <field name="model">classico.reservation</field>
        <field name="arch" type="xml">
            <graph string="Trend Reservasi" type="line">
                <field name="reservation_date" interval="day"/>
                <field name="guest_count" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View - Analisis Keluhan -->
    <record id="view_classico_complaint_pivot" model="ir.ui.view">
        <field name="name">classico.complaint.pivot</field>
        <field name="model">classico.complaint</field>
        <field name="arch" type="xml">
            <pivot string="Analisis Keluhan">
                <field name="category" type="row"/>
                <field name="responsible_division" type="col"/>
                <field name="resolution_time" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View - Keluhan per Kategori -->
    <record id="view_classico_complaint_graph" model="ir.ui.view">
        <field name="name">classico.complaint.graph</field>
        <field name="model">classico.complaint</field>
        <field name="arch" type="xml">
            <graph string="Frekuensi Keluhan" type="bar">
                <field name="category"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View - Laporan Shift -->
    <record id="view_classico_shift_pivot" model="ir.ui.view">
        <field name="name">classico.shift.report.pivot</field>
        <field name="model">classico.shift.report</field>
        <field name="arch" type="xml">
            <pivot string="Analisis Shift">
                <field name="report_date" type="row" interval="week"/>
                <field name="division" type="row"/>
                <field name="shift_type" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Dashboard Action untuk CEO & Manager -->
    <record id="action_classico_dashboard_reservation" model="ir.actions.act_window">
        <field name="name">Laporan Reservasi</field>
        <field name="res_model">classico.reservation</field>
        <field name="view_mode">graph,pivot,tree</field>
        <field name="domain">[('state', 'in', ['confirmed', 'arrived', 'done'])]</field>
        <field name="context">{
            'search_default_this_week': 1,
            'group_by': ['reservation_date:week']
        }</field>
    </record>

    <record id="action_classico_dashboard_complaint" model="ir.actions.act_window">
        <field name="name">Laporan Keluhan</field>
        <field name="res_model">classico.complaint</field>
        <field name="view_mode">graph,pivot,tree</field>
        <field name="context">{'group_by': ['category']}</field>
    </record>

    <record id="action_classico_dashboard_shift" model="ir.actions.act_window">
        <field name="name">Laporan Shift</field>
        <field name="res_model">classico.shift.report</field>
        <field name="view_mode">pivot,tree</field>
        <field name="domain">[('state', '=', 'reviewed')]</field>
        <field name="context">{'group_by': ['division', 'shift_type']}</field>
    </record>

    <!-- Menu untuk Laporan -->
    <!-- Graph View - Operational Notes Trend -->
    <record id="view_classico_operational_note_graph" model="ir.ui.view">
        <field name="name">classico.operational.note.graph</field>
        <field name="model">classico.operational.note</field>
        <field name="arch" type="xml">
            <graph string="Trend Catatan Operasional" type="bar">
                <field name="division"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View - Operational Notes Analysis -->
    <record id="view_classico_operational_note_pivot" model="ir.ui.view">
        <field name="name">classico.operational.note.pivot</field>
        <field name="model">classico.operational.note</field>
        <field name="arch" type="xml">
            <pivot string="Analisis Catatan">
                <field name="note_date" type="row" interval="week"/>
                <field name="division" type="row"/>
                <field name="urgency" type="col"/>
                <field name="id" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Action - Operational Notes Dashboard -->
    <record id="action_classico_dashboard_operational_note" model="ir.actions.act_window">
        <field name="name">Catatan Operasional</field>
        <field name="res_model">classico.operational.note</field>
        <field name="view_mode">graph,pivot,tree</field>
        <field name="domain">[('state', '=', 'open')]</field>
        <field name="context">{'group_by': ['division']}</field>
    </record>

    <!-- Tab 1: Histori Reservasi -->
    <menuitem id="menu_classico_archive_reservation"
              name="Histori Reservasi"
              parent="menu_classico_archive"
              action="action_classico_dashboard_reservation"
              sequence="10"/>

    <!-- Tab 2: Analisis Shift -->
    <menuitem id="menu_classico_archive_shift"
              name="Analisis Shift"
              parent="menu_classico_archive"
              action="action_classico_dashboard_shift"
              sequence="20"/>

    <!-- Tab 3: Trend Keluhan -->
    <menuitem id="menu_classico_archive_complaint"
              name="Trend Keluhan"
              parent="menu_classico_archive"
              action="action_classico_dashboard_complaint"
              sequence="30"/>

    <!-- Tab 4: Catatan Operasional (NEW) -->
    <menuitem id="menu_classico_archive_operational_note"
              name="Catatan Operasional"
              parent="menu_classico_archive"
              action="action_classico_dashboard_operational_note"
              sequence="35"/>

    <!-- Tab 5: Laporan Evaluasi -->
    <menuitem id="menu_classico_archive_evaluation_link"
              name="Laporan Evaluasi"
              parent="menu_classico_archive"
              action="action_classico_evaluation_report"
              sequence="40"/>

</odoo>
