<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_classico_complaint_tree" model="ir.ui.view">
        <field name="name">classico.complaint.tree</field>
        <field name="model">classico.complaint</field>
        <field name="arch" type="xml">
                    <tree string="Keluhan Pelanggan" 
                        decoration-info="state=='open'"
                        decoration-warning="state=='in_progress'"
                        decoration-success="state=='resolved'"
                        decoration-muted="state=='closed'">
                                <field name="title"/>
                  <field name="incident_datetime"/>
                  <field name="category"/>
                  <field name="state" widget="badge"
                      decoration-info="state=='open'"
                      decoration-warning="state=='in_progress'"
                      decoration-success="state=='resolved'"
                      decoration-muted="state=='closed'"/>
                      <field name="responsible_division"/>
                  <field name="customer_name" optional="show"/>
                  <field name="resolution_time" widget="float_time" optional="show"/>
                 </tree>
        </field>
    </record>

    <!-- Quick Create View (judul saja) -->
    <record id="view_classico_complaint_quick_create" model="ir.ui.view">
        <field name="name">classico.complaint.quick.create</field>
        <field name="model">classico.complaint</field>
        <field name="arch" type="xml">
            <form string="Quick Create Keluhan">
                <group>
                    <field name="title" required="1" placeholder="Judul keluhan"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_classico_complaint_form" model="ir.ui.view">
        <field name="name">classico.complaint.form</field>
        <field name="model">classico.complaint</field>
        <field name="arch" type="xml">
            <form string="Keluhan Pelanggan">
                <header>
                    <button name="action_assign" string="Assign &amp; Start Progress" type="object" 
                            invisible="state != 'open'" class="oe_highlight"/>
                    <button name="action_resolve" string="Resolve" type="object" 
                            invisible="state != 'in_progress'" class="oe_highlight"/>
                    <button name="action_close" string="Close Ticket" type="object" 
                            invisible="state != 'resolved'" class="oe_highlight"/>
                    <button name="action_reopen" string="Reopen" type="object" 
                            invisible="state not in ['resolved', 'closed']" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="title" placeholder="Judul keluhan" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informasi Keluhan">
                            <field name="category" required="1"/>
                            <field name="priority" required="1"/>
                            <field name="incident_datetime" required="1"/>
                            <field name="customer_name" placeholder="Nama pelanggan (opsional)"/>
                        </group>
                        <group string="Status dan Penanganan">
                            <field name="responsible_division"/>
                            <field name="follow_up_required"/>
                            <field name="reported_by" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Deskripsi Keluhan" name="description">
                            <group col="2">
                                <field name="complaint_description" nolabel="1" required="1" colspan="2"
                                       placeholder="Jelaskan detail keluhan pelanggan..."/>
                            </group>
                        </page>
                        <page string="Tindak Lanjut" name="followup">
                            <field name="followup_ids"
                                   context="{'default_complaint_id': active_id, 'default_status': (state == 'resolved' and 'done') or (state == 'in_progress' and 'in_progress') or 'pending'}">
                                <tree editable="bottom"
                                      decoration-info="status=='in_progress'"
                                      decoration-warning="status=='pending'"
                                      decoration-success="status=='done'">
                                    <field name="update_datetime"/>
                                    <field name="status" widget="badge"/>
                                    <field name="note"/>
                                    <field name="updated_by" readonly="1"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="update_datetime"/>
                                        <field name="status" widget="badge"/>
                                        <field name="updated_by" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="note" nolabel="1" placeholder="Catatan tindak lanjut..."/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Penyelesaian" name="resolution" invisible="state == 'open'">
                            <group col="2">
                                <field name="resolution_notes" nolabel="1" 
                                       placeholder="Jelaskan tindakan yang telah dilakukan untuk menyelesaikan keluhan..."
                                       colspan="2"/>
                                <field name="resolution_datetime" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_classico_complaint_kanban" model="ir.ui.view">
        <field name="name">classico.complaint.kanban</field>
        <field name="model">classico.complaint</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile" create="true" quick_create="true" quick_create_view_id="view_classico_complaint_quick_create" group_create="true">
                <field name="name"/>
                <field name="title"/>
                <field name="category"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="complaint_description"/>
                <field name="responsible_division"/>
                <field name="incident_datetime"/>
                <field name="customer_name"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click 
                                           #{record.state.raw_value == 'open' ? 'oe_kanban_color_3' : ''}
                                           #{record.state.raw_value == 'in_progress' ? 'oe_kanban_color_2' : ''}
                                           #{record.state.raw_value == 'resolved' ? 'oe_kanban_color_10' : ''}
                                           #{record.state.raw_value == 'closed' ? 'oe_kanban_color_8' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="title"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <t t-if="record.state.raw_value == 'open'">
                                                <span class="badge text-bg-info">Open</span>
                                            </t>
                                            <t t-if="record.state.raw_value == 'in_progress'">
                                                <span class="badge text-bg-warning">In Progress</span>
                                            </t>
                                            <t t-if="record.state.raw_value == 'resolved'">
                                                <span class="badge text-bg-success">Resolved</span>
                                            </t>
                                            <t t-if="record.state.raw_value == 'closed'">
                                                <span class="badge text-bg-secondary">Closed</span>
                                            </t>
                                            <span> - </span>
                                            <field name="name"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <field name="complaint_description"/>
                                    </div>
                                    <div class="o_text_overflow">
                                        <field name="responsible_division"/>
                                        <span> - </span>
                                        <field name="incident_datetime"/>
                                    </div>
                                </div>
                                <hr/>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="category"/>
                                        <span> - </span>
                                        <field name="customer_name"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <t t-if="record.priority.raw_value == 'low'">
                                            <span class="badge text-bg-secondary">Low</span>
                                        </t>
                                        <t t-if="record.priority.raw_value == 'medium'">
                                            <span class="badge text-bg-info">Medium</span>
                                        </t>
                                        <t t-if="record.priority.raw_value == 'high'">
                                            <span class="badge text-bg-warning">High</span>
                                        </t>
                                        <t t-if="record.priority.raw_value == 'urgent'">
                                            <span class="badge text-bg-danger">Urgent</span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_classico_complaint_search" model="ir.ui.view">
        <field name="name">classico.complaint.search</field>
        <field name="model">classico.complaint</field>
        <field name="arch" type="xml">
            <search string="Cari Keluhan">
                <field name="name"/>
                <field name="title"/>
                <field name="category"/>
                <field name="customer_name"/>
                <field name="responsible_division"/>
                <separator/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Resolved" name="resolved" domain="[('state', '=', 'resolved')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Perlu Follow Up" name="follow_up" domain="[('follow_up_required', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Kategori" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Divisi" name="group_division" context="{'group_by': 'responsible_division'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_classico_complaint" model="ir.actions.act_window">
        <field name="name">Ticketing Keluhan Pelanggan</field>
        <field name="res_model">classico.complaint</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_open': 1, 'search_default_in_progress': 1, 'create': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat tiket keluhan baru
            </p>
            <p>
                Sistem ticketing untuk mendokumentasikan dan melacak penyelesaian keluhan pelanggan.
                Semua aktivitas tercatat otomatis untuk audit trail (OW-08).
            </p>
        </field>
    </record>

    <!-- Archive Action -->
    <record id="action_classico_complaint_archive" model="ir.actions.act_window">
        <field name="name">Histori Keluhan</field>
        <field name="res_model">classico.complaint</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', 'in', ['resolved', 'closed'])]</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_classico_complaint"
              name="Ticketing Keluhan"
              parent="menu_classico_root"
              action="action_classico_complaint"
              sequence="40"/>

    <menuitem id="menu_classico_archive_complaint"
              name="Histori Keluhan"
              parent="menu_classico_archive"
              action="action_classico_complaint_archive"
              sequence="30"/>
</odoo>
