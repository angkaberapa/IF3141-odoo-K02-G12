<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_classico_shift_report_tree" model="ir.ui.view">
        <field name="name">classico.shift.report.tree</field>
        <field name="model">classico.shift.report</field>
        <field name="arch" type="xml">
            <tree string="Laporan Shift" decoration-info="state=='submitted'" 
                  decoration-success="state=='reviewed'" decoration-muted="state=='draft'">
                <field name="name"/>
                <field name="report_date"/>
                <field name="shift_type" widget="badge"/>
                <field name="division" widget="badge"/>
                <field name="submitted_by" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state=='draft'"
                       decoration-info="state=='submitted'"
                       decoration-success="state=='reviewed'"/>
            </tree>
        </field>
    </record>

    <!-- Quick Create View (tanpa input ID) -->
    <record id="view_classico_shift_report_quick_create" model="ir.ui.view">
        <field name="name">classico.shift.report.quick.create</field>
        <field name="model">classico.shift.report</field>
        <field name="arch" type="xml">
            <form string="Quick Create Laporan Shift">
                <group>
                    <field name="name" readonly="1"/>
                    <field name="shift_type" required="1"/>
                    <field name="division" required="1"/>
                    <field name="report_date"/>
                </group>
                <group>
                    <field name="operational_condition" placeholder="Ringkas kondisi operasional..."/>
                </group>
            </form>
        </field>
    </record>

    <!-- Form View dengan template berbeda per divisi (OW-04) -->
    <record id="view_classico_shift_report_form" model="ir.ui.view">
        <field name="name">classico.shift.report.form</field>
        <field name="model">classico.shift.report</field>
        <field name="arch" type="xml">
            <form string="Laporan Shift" readonly="state == 'reviewed'">
                <header>
                    <button name="action_submit" string="Submit Laporan" type="object" 
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_review" string="Review Laporan" type="object" 
                            invisible="state != 'submitted'" class="oe_highlight" groups="base.group_system"/>
                    <button name="action_reset_to_draft" string="Reset ke Draft" type="object" 
                            invisible="state not in ['submitted', 'reviewed']" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,reviewed"/>
                </header>
                <sheet readonly="state == 'reviewed'">
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informasi Dasar">
                            <field name="report_date" required="1"/>
                            <field name="shift_type" required="1"/>
                            <field name="division" required="1"/>
                        </group>
                        <group string="Status Submit">
                            <field name="submitted_by" readonly="1"/>
                            <field name="submit_datetime" readonly="1"/>
                            <field name="reviewed_by" readonly="1"/>
                            <field name="review_datetime" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Ringkasan Handover" name="general">
                            <group>
                                <group>
                                    <field name="operational_condition" required="1" 
                                           placeholder="Deskripsikan kondisi operasional secara keseluruhan..."/>
                                </group>
                                <group>
                                    <field name="technical_issues" 
                                           placeholder="Deskripsikan kendala teknis yang terjadi..."/>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="special_instructions" 
                                           placeholder="Instruksi penting untuk shift berikutnya..."/>
                                </group>
                                <group>
                                    <field name="unfinished_tasks" 
                                           placeholder="Tugas yang belum terselesaikan..."/>
                                </group>
                            </group>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_classico_shift_report_kanban" model="ir.ui.view">
        <field name="name">classico.shift.report.kanban</field>
        <field name="model">classico.shift.report</field>
        <field name="arch" type="xml">
            <kanban default_group_by="division" class="o_kanban_mobile" create="true" quick_create="false" group_create="true">
                <field name="name"/>
                <field name="report_date"/>
                <field name="shift_type"/>
                <field name="division"/>
                <field name="state"/>
                <field name="submitted_by"/>
                <field name="operational_condition"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click 
                                           #{record.division.raw_value == 'floor' ? 'oe_kanban_color_3' : ''}
                                           #{record.division.raw_value == 'kitchen' ? 'oe_kanban_color_5' : ''}
                                           #{record.division.raw_value == 'bar' ? 'oe_kanban_color_2' : ''}
                                           #{record.division.raw_value == 'bakery' ? 'oe_kanban_color_7' : ''}
                                           #{record.division.raw_value == 'stock_keeper' ? 'oe_kanban_color_4' : ''}
                                           #{record.division.raw_value == 'cashier' ? 'oe_kanban_color_6' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="shift_type" widget="badge"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_user">
                                        <field name="submitted_by" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="o_text_overflow">
                                        <field name="operational_condition"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="report_date"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <t t-if="record.state.raw_value == 'draft'">
                                            <span class="badge text-bg-secondary">Draft</span>
                                        </t>
                                        <t t-if="record.state.raw_value == 'submitted'">
                                            <span class="badge text-bg-info">Submitted</span>
                                        </t>
                                        <t t-if="record.state.raw_value == 'reviewed'">
                                            <span class="badge text-bg-success">Reviewed</span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_classico_shift_report_search" model="ir.ui.view">
        <field name="name">classico.shift.report.search</field>
        <field name="model">classico.shift.report</field>
        <field name="arch" type="xml">
            <search string="Cari Laporan Shift">
                <field name="name"/>
                <field name="division"/>
                <field name="report_date"/>
                <filter string="Hari Ini" name="today" 
                        domain="[('report_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Minggu Ini" name="this_week" 
                        domain="[('report_date', '&gt;=', (context_today() - relativedelta(weeks=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Shift Pagi" name="morning" domain="[('shift_type', '=', 'morning')]"/>
                <filter string="Shift Malam" name="evening" domain="[('shift_type', '=', 'evening')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Reviewed" name="reviewed" domain="[('state', '=', 'reviewed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Divisi" name="group_division" context="{'group_by': 'division'}"/>
                    <filter string="Shift" name="group_shift" context="{'group_by': 'shift_type'}"/>
                    <filter string="Tanggal" name="group_date" context="{'group_by': 'report_date'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_classico_shift_report" model="ir.actions.act_window">
        <field name="name">Laporan Shift Digital</field>
        <field name="res_model">classico.shift.report</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_today': 1, 'create': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat laporan shift baru
            </p>
            <p>
                Sistem laporan shift digital menggantikan handover manual via WhatsApp.
                Setiap divisi wajib submit laporan sebelum shift berakhir (OW-04).
            </p>
        </field>
    </record>

    <!-- Archive Action -->
    <record id="action_classico_shift_archive" model="ir.actions.act_window">
        <field name="name">Histori Laporan Shift</field>
        <field name="res_model">classico.shift.report</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'reviewed')]</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_classico_shift"
              name="Laporan Shift Digital"
              parent="menu_classico_root"
              action="action_classico_shift_report"
              sequence="30"/>

    <menuitem id="menu_classico_archive_shift"
              name="Histori Laporan Shift"
              parent="menu_classico_archive"
              action="action_classico_shift_archive"
              sequence="20"/>
</odoo>
