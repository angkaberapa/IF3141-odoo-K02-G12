<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban View - Visual Dashboard dengan warna -->
    <record id="view_classico_table_kanban" model="ir.ui.view">
        <field name="name">classico.table.kanban</field>
        <field name="model">classico.table</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="floor_section">
                <field name="name"/>
                <field name="capacity"/>
                <field name="state"/>
                <field name="floor_section"/>
                <field name="notes"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click 
                                           #{record.state.raw_value == 'available' ? 'oe_kanban_color_3' : ''}
                                           #{record.state.raw_value == 'occupied' ? 'oe_kanban_color_2' : ''}
                                           #{record.state.raw_value == 'reserved' ? 'oe_kanban_color_5' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            Meja <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="o_kanban_record_subtitle">
                                        <i class="fa fa-users" title="Kapasitas"/> <field name="capacity"/> kursi
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="state" widget="badge" 
                                           decoration-success="state=='available'"
                                           decoration-danger="state=='occupied'"
                                           decoration-warning="state=='reserved'"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="floor_section"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <button name="action_set_available" type="object" 
                                                string="Tersedia" class="btn btn-sm btn-success"
                                                invisible="state == 'available'"/>
                                        <button name="action_set_occupied" type="object" 
                                                string="Terisi" class="btn btn-sm btn-danger"
                                                invisible="state == 'occupied'"/>
                                        <button name="action_set_reserved" type="object" 
                                                string="Dipesan" class="btn btn-sm btn-warning"
                                                invisible="state == 'reserved'"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tree View dengan dekorasi warna -->
    <record id="view_classico_table_tree" model="ir.ui.view">
        <field name="name">classico.table.tree</field>
        <field name="model">classico.table</field>
        <field name="arch" type="xml">
            <tree string="Kapasitas Meja" 
                  decoration-success="state=='available'" 
                  decoration-danger="state=='occupied'" 
                  decoration-warning="state=='reserved'">
                <field name="name"/>
                <field name="capacity"/>
                <field name="floor_section"/>
                <field name="state" widget="badge"
                       decoration-success="state=='available'"
                       decoration-danger="state=='occupied'"
                       decoration-warning="state=='reserved'"/>
                <field name="current_reservation_id"/>
                <field name="last_updated" widget="relative"/>
                <field name="updated_by"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_classico_table_form" model="ir.ui.view">
        <field name="name">classico.table.form</field>
        <field name="model">classico.table</field>
        <field name="arch" type="xml">
            <form string="Meja">
                <header>
                    <button name="action_set_available" string="Set Tersedia" type="object" 
                            class="oe_highlight" invisible="state == 'available'"/>
                    <button name="action_set_occupied" string="Set Terisi" type="object" 
                            class="btn-danger" invisible="state == 'occupied'"/>
                    <button name="action_set_reserved" string="Set Dipesan" type="object" 
                            class="btn-warning" invisible="state == 'reserved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,occupied,reserved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Placeholder untuk button box di masa depan -->
                    </div>
                    <group>
                        <group string="Informasi Meja">
                            <field name="name" required="1"/>
                            <field name="capacity" required="1"/>
                            <field name="floor_section"/>
                        </group>
                        <group string="Status Terkini">
                            <field name="current_reservation_id" readonly="1"/>
                            <field name="last_updated" readonly="1"/>
                            <field name="updated_by" readonly="1"/>
                        </group>
                    </group>
                    <group string="Catatan">
                        <field name="notes" nolabel="1" placeholder="Catatan khusus tentang meja ini..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_classico_table_search" model="ir.ui.view">
        <field name="name">classico.table.search</field>
        <field name="model">classico.table</field>
        <field name="arch" type="xml">
            <search string="Cari Meja">
                <field name="name"/>
                <field name="capacity"/>
                <filter string="Tersedia" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Terisi" name="occupied" domain="[('state', '=', 'occupied')]"/>
                <filter string="Dipesan" name="reserved" domain="[('state', '=', 'reserved')]"/>
                <separator/>
                <filter string="Indoor" name="indoor" domain="[('floor_section', '=', 'indoor')]"/>
                <filter string="Outdoor" name="outdoor" domain="[('floor_section', '=', 'outdoor')]"/>
                <filter string="VIP" name="vip" domain="[('floor_section', '=', 'vip')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Area" name="group_floor" context="{'group_by': 'floor_section'}"/>
                    <filter string="Kapasitas" name="group_capacity" context="{'group_by': 'capacity'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_classico_table" model="ir.actions.act_window">
        <field name="name">Dashboard Kapasitas Meja</field>
        <field name="res_model">classico.table</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tambah meja baru
            </p>
            <p>
                Dashboard ini menampilkan status real-time seluruh meja di kafe.
                - Hijau: Tersedia
                - Merah: Terisi
                - Kuning: Dipesan
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_classico_table"
              name="Dashboard Kapasitas Meja"
              parent="menu_classico_root"
              action="action_classico_table"
              sequence="20"
              groups="group_classico_staff"/>
</odoo>
